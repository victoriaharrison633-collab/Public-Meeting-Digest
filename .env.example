# ─────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to boot without these
# ─────────────────────────────────────────────────────────────

# Anthropic API key. Server-side only — never give this a NEXT_PUBLIC_ prefix.
# Set a spend limit in the Anthropic Console before deploying: this build's
# rate limiter is in-memory and the Console cap is the real backstop.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# The only place a model id may appear in this project.
AI_MODEL=claude-opus-5

# The deployed origin. The CSRF Origin check compares against this exactly.
# In production this MUST be the real URL — left at localhost, every request 403s.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Where these live
# ─────────────────────────────────────────────────────────────
# Development: .env.local (gitignored, never deployed).
# Production:  Vercel Project Settings → Environment Variables only.
# Never commit either file, and never reuse one environment's key in another.
